<Window x:Class="IArchiveMovieBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Internet Archive Movie Browser"
        Width="560" Height="335"
        MinWidth="460" MinHeight="270"
        WindowStartupLocation="CenterScreen">

    <StackPanel Margin="12">
        <TextBlock Text="Search Internet Archive"
                   FontSize="17"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10"
                   Foreground="{x:Static SystemColors.ControlTextBrush}"/>

        <TextBlock Text="Search"
                   FontSize="13"
                   Margin="0,0,0,4"
                   Foreground="{x:Static SystemColors.ControlTextBrush}"/>
        <TextBox x:Name="QueryTextBox"
                 MinHeight="30"
                 Padding="6,4"
                 FontSize="14"
                 VerticalContentAlignment="Center"
                 AutomationProperties.Name="Search Internet Archive"/>
        <Button x:Name="SearchButton"
                Content="Search"
                Width="96" Height="32"
                HorizontalAlignment="Left"
                Margin="0,8,0,0"
                IsDefault="True"
                Click="OnSearchClick"/>

        <TextBlock Text="Search public Internet Archive movie and video titles."
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,12,0,8"
                   Foreground="{x:Static SystemColors.ControlTextBrush}"/>

        <ProgressBar x:Name="SearchProgress"
                     Height="6"
                     IsIndeterminate="True"
                     Visibility="Collapsed"
                     AutomationProperties.Name="Search progress"/>
        <TextBlock x:Name="StatusText"
                   Text="Enter a search term."
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0"
                   Foreground="{x:Static SystemColors.ControlTextBrush}"
                   AutomationProperties.Name="Search status"/>

        <Border x:Name="ResultStage"
                BorderThickness="1"
                BorderBrush="{x:Static SystemColors.ActiveBorderBrush}"
                Background="{x:Static SystemColors.ControlBrush}"
                Padding="8"
                Margin="0,10,0,0"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="ResultStageText"
                           Text=""
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,0,0,6"
                           Foreground="{x:Static SystemColors.ControlTextBrush}"/>
                <Button x:Name="OpenResultsButton"
                        Content="No Results"
                        Width="150" Height="32"
                        HorizontalAlignment="Left"
                        IsEnabled="False"
                        Click="OnOpenResultsClick"/>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
