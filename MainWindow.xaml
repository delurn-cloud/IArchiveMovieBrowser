<Window x:Class="IArchiveMovieBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Internet Archive Movie Browser"
        Width="560" Height="455"
        MinWidth="460" MinHeight="390"
        WindowStartupLocation="CenterScreen">

    <StackPanel Margin="12">
        <TextBlock Text="Search Internet Archive"
                   FontSize="17"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10"
                   Foreground="{x:Static SystemColors.ControlTextBrush}"/>

        <TextBlock Text="Search"
                   FontSize="13"
                   Margin="0,0,0,4"
                   Foreground="{x:Static SystemColors.ControlTextBrush}"/>
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="QueryTextBox"
                     Grid.Column="0"
                     MinHeight="30"
                     Padding="6,4"
                     FontSize="14"
                     VerticalContentAlignment="Center"
                     AutomationProperties.Name="Search Internet Archive"/>
            <ComboBox x:Name="SearchScopeCombo"
                      Grid.Column="1"
                      Height="30"
                      Width="172"
                      Margin="8,0,0,0"
                      VerticalAlignment="Center"
                      SelectedIndex="0"
                      AutomationProperties.Name="Search scope"
                      AutomationProperties.HelpText="Non-video Internet Archive items matching your search, such as texts, audio, software, or images."
                      ToolTip="Non-video Internet Archive items matching your search, such as texts, audio, software, or images.">
                <ComboBoxItem Content="Watchable video"/>
                <ComboBoxItem Content="Related materials"/>
                <ComboBoxItem Content="Everything"/>
            </ComboBox>
            <Button x:Name="SearchButton"
                    Grid.Column="2"
                    Content="Search"
                    Width="84" Height="32"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    IsDefault="True"
                    Click="OnSearchClick"/>
        </Grid>

        <Expander x:Name="NarrowResults"
                  Header="Narrow results"
                  IsExpanded="False"
                  Margin="0,0,0,8"
                  AutomationProperties.Name="Narrow results">
            <Grid Margin="0,6,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Made by / credited to"
                           FontSize="12"
                           Margin="0,0,8,6"
                           VerticalAlignment="Center"
                           Foreground="{x:Static SystemColors.ControlTextBrush}"/>
                <TextBox x:Name="ActorTextBox"
                         Grid.Row="0" Grid.Column="1"
                         MinWidth="120"
                         MinHeight="26"
                         Padding="6,4"
                         FontSize="13"
                         VerticalContentAlignment="Center"
                         AutomationProperties.Name="Made by / credited to"
                         AutomationProperties.HelpText="Optionally narrow results by a name or organization in Internet Archive creator metadata, such as a director, producer, studio, uploader, or curator. This does not search actors or cast."/>
                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="Year"
                           FontSize="12"
                           Margin="0,6,8,0"
                           VerticalAlignment="Center"
                           Foreground="{x:Static SystemColors.ControlTextBrush}"/>
                <TextBox x:Name="YearTextBox"
                         Grid.Row="1" Grid.Column="1"
                         MinWidth="120"
                         MinHeight="26"
                         Padding="6,4"
                         FontSize="13"
                         VerticalContentAlignment="Center"
                         AutomationProperties.Name="Year"
                         AutomationProperties.HelpText="Optional; exactly four digits from 1800 through the current year plus one."/>
            </Grid>
        </Expander>

        <TextBlock Text="Search public Internet Archive movie and video titles."
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,12,0,8"
                   Foreground="{x:Static SystemColors.ControlTextBrush}"/>

        <ProgressBar x:Name="SearchProgress"
                     Height="6"
                     IsIndeterminate="True"
                     Visibility="Collapsed"
                     AutomationProperties.Name="Search progress"/>
        <TextBlock x:Name="StatusText"
                   Text="Enter a search term."
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0"
                   Foreground="{x:Static SystemColors.ControlTextBrush}"
                   AutomationProperties.Name="Search status"/>

        <Border x:Name="ResultStage"
                BorderThickness="1"
                BorderBrush="{x:Static SystemColors.ActiveBorderBrush}"
                Background="{x:Static SystemColors.ControlBrush}"
                Padding="8"
                Margin="0,10,0,0"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="ResultStageText"
                           Text=""
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,0,0,6"
                           Foreground="{x:Static SystemColors.ControlTextBrush}"/>
                <Button x:Name="OpenResultsButton"
                        Content="No Results"
                        Width="150" Height="32"
                        HorizontalAlignment="Left"
                        IsEnabled="False"
                        Click="OnOpenResultsClick"/>
            </StackPanel>
        </Border>
<Border BorderThickness="1"
                BorderBrush="{x:Static SystemColors.ActiveBorderBrush}"
                Background="{x:Static SystemColors.ControlBrush}"
                Padding="8"
                Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="External player"
                           FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"
                           Foreground="{x:Static SystemColors.ControlTextBrush}"/>
                <TextBox x:Name="PlayerPathText"
                         IsReadOnly="True"
                         FontSize="11"
                         TextWrapping="Wrap"
                         Margin="0,0,0,6"
                         BorderBrush="{x:Static SystemColors.ActiveBorderBrush}"
                         AutomationProperties.Name="External player executable path"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button x:Name="ChoosePlayerButton"
                            Content="Choose player…"
                            Width="130" Height="30"
                            Margin="0,0,8,0"
                            Click="OnChoosePlayerClick"/>
                    <Button x:Name="ChangePlayerButton"
                            Content="Change…"
                            Width="96" Height="30"
                            Margin="0,0,8,0"
                            Visibility="Collapsed"
                            Click="OnChoosePlayerClick"/>
                    <Button x:Name="ClearPlayerButton"
                            Content="Clear"
                            Width="80" Height="30"
                            Visibility="Collapsed"
                            Click="OnClearPlayerClick"/>
                </StackPanel>
                <TextBlock x:Name="PlayerStatusText"
                           Text="Select a media-player executable (.exe) to open selected video streams."
                           FontSize="12" TextWrapping="Wrap"
                           Foreground="{x:Static SystemColors.ControlTextBrush}"
                           AutomationProperties.Name="External player status"/>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
