<Window x:Class="IArchiveMovieBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Internet Archive Movie Browser"
        Icon="/IArchiveMovieBrowser.ico"
        Width="560" Height="455"
        MinWidth="460" MinHeight="390"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ScrollViewer x:Name="MainScrollViewer"
                      Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
        <TextBlock Text="Search Internet Archive"
                   FontSize="17"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10"
                   Foreground="{x:Static SystemColors.ControlTextBrush}"/>

        <TextBlock Text="Search"
                   FontSize="13"
                   Margin="0,0,0,4"
                   Foreground="{x:Static SystemColors.ControlTextBrush}"/>
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="QueryTextBox"
                     Grid.Column="0"
                     MinHeight="30"
                     Padding="6,4"
                     FontSize="14"
                     VerticalContentAlignment="Center"
                     AutomationProperties.Name="Search Internet Archive"
                     AutomationProperties.HelpText="Searches titles as the phrase you enter.

You can enter part of a title to discover likely matches, then search again using a full title for more precise results.">
                <TextBox.ToolTip>
                    <ToolTip MaxWidth="380">
                        <TextBlock MaxWidth="380"
                                   TextWrapping="Wrap"
                                   Text="Searches titles as the phrase you enter.

You can enter part of a title to discover likely matches, then search again using a full title for more precise results."/>
                    </ToolTip>
                </TextBox.ToolTip>
            </TextBox>
            <ComboBox x:Name="SearchScopeCombo"
                      Grid.Column="1"
                      Height="30"
                      Width="172"
                      Margin="8,0,0,0"
                      VerticalAlignment="Center"
                      SelectedIndex="0"
                      AutomationProperties.Name="Search scope"
                      AutomationProperties.HelpText="Non-video Internet Archive items matching your search, such as texts, audio, software, or images.">
                <ComboBox.ToolTip>
                    <ToolTip MaxWidth="380">
                        <TextBlock MaxWidth="380"
                                   TextWrapping="Wrap"
                                   Text="Non-video Internet Archive items matching your search, such as texts, audio, software, or images."/>
                    </ToolTip>
                </ComboBox.ToolTip>
                <ComboBoxItem Content="Watchable video"/>
                <ComboBoxItem Content="Related materials"/>
                <ComboBoxItem Content="Everything"/>
            </ComboBox>
            <Button x:Name="SearchButton"
                    Grid.Column="2"
                    Content="Search"
                    Width="84" Height="32"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    IsDefault="True"
                    Click="OnSearchClick"/>
        </Grid>

        <Expander x:Name="NarrowResults"
                  Header="Narrow results"
                  IsExpanded="False"
                  Margin="0,0,0,8"
                  AutomationProperties.Name="Narrow results">
            <Grid Margin="0,6,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Made by / credited to"
                           FontSize="12"
                           Margin="0,0,8,6"
                           VerticalAlignment="Center"
                           Foreground="{x:Static SystemColors.ControlTextBrush}"/>
                <TextBox x:Name="ActorTextBox"
                         Grid.Row="0" Grid.Column="1"
                         MinWidth="120"
                         MinHeight="26"
                         Padding="6,4"
                         FontSize="13"
                         VerticalContentAlignment="Center"
                         AutomationProperties.Name="Made by / credited to"
                         AutomationProperties.HelpText="Optionally narrow results by a name or organization in Internet Archive creator metadata, such as a director, producer, studio, uploader, or curator. This does not search actors or cast."/>
                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="Year"
                           FontSize="12"
                           Margin="0,6,8,0"
                           VerticalAlignment="Center"
                           Foreground="{x:Static SystemColors.ControlTextBrush}"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,0">
                    <StackPanel Margin="0,0,4,0">
                        <TextBlock Text="From"
                                   FontSize="11"
                                   Margin="0,0,0,2"
                                   Foreground="{x:Static SystemColors.ControlTextBrush}"/>
                        <TextBox x:Name="YearFromTextBox"
                                 MinWidth="72"
                                 Width="72"
                                 Height="24"
                                 Padding="6,3"
                                 FontSize="12"
                                 AutomationProperties.Name="Year from"
                                 AutomationProperties.HelpText="Optional inclusive lower bound for an exact year or year range, exactly four digits from 1800 through the current year plus one. Internet Archive metadata is incomplete: many matching items carry no year value at all, so adding a year quietly excludes them."/>
                    </StackPanel>
                    <TextBlock Text="to"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,14,4,0"
                               Foreground="{x:Static SystemColors.ControlTextBrush}"/>
                    <StackPanel Margin="0,0,0,0">
                        <TextBlock Text="To"
                                   FontSize="11"
                                   Margin="0,0,0,2"
                                   Foreground="{x:Static SystemColors.ControlTextBrush}"/>
                        <TextBox x:Name="YearToTextBox"
                                 MinWidth="72"
                                 Width="72"
                                 Height="24"
                                 Padding="6,3"
                                 FontSize="12"
                                 AutomationProperties.Name="Year to"
                                 AutomationProperties.HelpText="Optional inclusive upper bound for an exact year or year range, exactly four digits from 1800 through the current year plus one. Must be at least Year from. Internet Archive metadata is incomplete: many matching items carry no year value at all, so adding a year quietly excludes them."/>
                    </StackPanel>
                </StackPanel>
<TextBlock Grid.Row="2" Grid.Column="0"
                           Text="Keywords"
                           FontSize="12"
                           Margin="0,6,8,0"
                           VerticalAlignment="Top"
                           Foreground="{x:Static SystemColors.ControlTextBrush}"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,4,0,0">
                    <TextBox x:Name="KeywordsTextBox"
                             MinWidth="120"
                             MinHeight="26"
                             Padding="6,4"
                             FontSize="13"
                             VerticalContentAlignment="Center"
                             TextChanged="OnDiscoveryEntryChanged"
                             AutomationProperties.Name="Keywords"
                             AutomationProperties.HelpText="Optionally narrow results by descriptive words or phrases in Internet Archive metadata. Separate terms with spaces or commas. Quote a phrase to search those words together, for example &quot;country house&quot; or &quot;Agatha Christie&quot;. Keywords on their own are enough to run a search.">
                        <TextBox.ToolTip>
                            <ToolTip MaxWidth="380">
                                <TextBlock MaxWidth="380" TextWrapping="Wrap"
                                           Text="Optionally narrow results by descriptive words or phrases in Internet Archive metadata. Separate terms with spaces or commas. Quote a phrase to search those words together, for example &quot;country house&quot; or &quot;Agatha Christie&quot;. Keywords on their own are enough to run a search."/>
                            </ToolTip>
                        </TextBox.ToolTip>
                    </TextBox>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Search in"
                                   FontSize="11"
                                   Margin="0,0,4,0"
                                   VerticalAlignment="Center"
                                   Foreground="{x:Static SystemColors.ControlTextBrush}"/>
                        <ComboBox x:Name="KeywordFieldsCombo"
                                  Width="168" Height="24"
                                  SelectedIndex="0"
                                  VerticalAlignment="Center"
                                  AutomationProperties.Name="Search in"
                                  AutomationProperties.HelpText="Subjects searches the Internet Archive subject field, which is a short controlled list of descriptive words an uploader chose. Subjects and descriptions also searches the free-text description, which finds more material but also matches books, newspapers, and unrelated uploads whose prose happens to mention the words. Neither option checks that a keyword really describes a film.">
                            <ComboBox.ToolTip>
                                <ToolTip MaxWidth="380">
                                    <TextBlock MaxWidth="380" TextWrapping="Wrap"
                                               Text="Subjects searches the Internet Archive subject field, which is a short controlled list of descriptive words an uploader chose. Subjects and descriptions also searches the free-text description, which finds more material but also matches books, newspapers, and unrelated uploads whose prose happens to mention the words. Neither option checks that a keyword really describes a film."/>
                                </ToolTip>
                            </ComboBox.ToolTip>
                            <ComboBoxItem Content="Subjects"/>
                            <ComboBoxItem Content="Subjects and descriptions"/>
                        </ComboBox>
                        <TextBlock Text="Match"
                                   FontSize="11"
                                   Margin="10,0,4,0"
                                   VerticalAlignment="Center"
                                   Foreground="{x:Static SystemColors.ControlTextBrush}"/>
                        <ComboBox x:Name="MatchModeCombo"
                                  Width="104" Height="24"
                                  SelectedIndex="0"
                                  VerticalAlignment="Center"
                                  AutomationProperties.Name="Match mode"
                                  AutomationProperties.HelpText="All terms requires every term you list to match. Any terms requires at least one. Exact phrase treats your whole entry as a single phrase and ignores the separators, which is the same result as putting the whole entry in one pair of double quotes.">
                            <ComboBox.ToolTip>
                                <ToolTip MaxWidth="380">
                                    <TextBlock MaxWidth="380" TextWrapping="Wrap"
                                               Text="All terms requires every term you list to match. Any terms requires at least one. Exact phrase treats your whole entry as a single phrase and ignores the separators, which is the same result as putting the whole entry in one pair of double quotes."/>
                                </ToolTip>
                            </ComboBox.ToolTip>
                            <ComboBoxItem Content="All terms"/>
                            <ComboBoxItem Content="Any terms"/>
                            <ComboBoxItem Content="Exact phrase"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Row="3" Grid.Column="0"
                           Text="Exclude words"
                           FontSize="12"
                           Margin="0,6,8,0"
                           VerticalAlignment="Top"
                           Foreground="{x:Static SystemColors.ControlTextBrush}"/>
                <TextBox x:Name="ExcludedTermsTextBox"
                         Grid.Row="3" Grid.Column="1"
                         MinWidth="120"
                         MinHeight="26"
                         Margin="0,4,0,0"
                         Padding="6,4"
                         FontSize="13"
                         VerticalContentAlignment="Center"
                         TextChanged="OnDiscoveryEntryChanged"
                         AutomationProperties.Name="Exclude words"
                         AutomationProperties.HelpText="Optionally hide items whose metadata contains any of these words or phrases. Uses the same quoting rules as Keywords. Every term you list is excluded. Excluded words on their own are enough to run a search.">
                    <TextBox.ToolTip>
                        <ToolTip MaxWidth="380">
                            <TextBlock MaxWidth="380" TextWrapping="Wrap"
                                       Text="Optionally hide items whose metadata contains any of these words or phrases. Uses the same quoting rules as Keywords. Every term you list is excluded. Excluded words on their own are enough to run a search."/>
                        </ToolTip>
                    </TextBox.ToolTip>
                </TextBox>
                <TextBlock Grid.Row="4" Grid.Column="0"
                           Text="Video collections"
                           FontSize="12"
                           Margin="0,6,8,0"
                           VerticalAlignment="Center"
                           Foreground="{x:Static SystemColors.ControlTextBrush}"/>
                <ComboBox x:Name="VideoCollectionsCombo"
                          Grid.Row="4" Grid.Column="1"
                          Height="24" Margin="0,4,0,0"
                          SelectedIndex="0"
                          AutomationProperties.Name="Video collections"
                          AutomationProperties.HelpText="The Internet Archive has no separate television media type: television episodes are filed as video and can only be recognised by the collections they belong to. TV collections keeps items filed in the best-known television collections. Exclude known TV collections removes items in those collections. Neither is exact: some television sits in other collections, and some non-television items sit in these, so this is not a complete Movies-only or Television-only separation. These options only narrow collections — your Search scope choice still decides whether non-video items are included at all.">
                    <ComboBox.ToolTip>
                        <ToolTip MaxWidth="380">
                            <TextBlock MaxWidth="380" TextWrapping="Wrap"
                                       Text="The Internet Archive has no separate television media type: television episodes are filed as video and can only be recognised by the collections they belong to. TV collections keeps items filed in the best-known television collections. Exclude known TV collections removes items in those collections. Neither is exact: some television sits in other collections, and some non-television items sit in these, so this is not a complete Movies-only or Television-only separation. These options only narrow collections — your Search scope choice still decides whether non-video items are included at all."/>
                        </ToolTip>
                    </ComboBox.ToolTip>
                    <ComboBoxItem Content="All watchable video"/>
                    <ComboBoxItem Content="TV collections"/>
                    <ComboBoxItem Content="Exclude known TV collections"/>
                </ComboBox>
                <TextBlock Grid.Row="5" Grid.Column="0"
                           Text="Order by"
                           FontSize="12"
                           Margin="0,6,8,0"
                           VerticalAlignment="Center"
                           Foreground="{x:Static SystemColors.ControlTextBrush}"/>
                <ComboBox x:Name="OrderingCombo"
                          Grid.Row="5" Grid.Column="1"
                          Height="24" Margin="0,4,0,0"
                          SelectedIndex="0"
                          AutomationProperties.Name="Order by"
                          AutomationProperties.HelpText="Internet Archive default uses the Internet Archive's own ordering, which is not ranked by relevance. Most downloaded lists the most-downloaded items first. Items with equal download counts are then ordered by identifier, so they appear in a consistent order. This is not a frozen snapshot: results can still shift between pages if items are added, removed, or change download count while you page.">
                    <ComboBox.ToolTip>
                        <ToolTip MaxWidth="380">
                            <TextBlock MaxWidth="380" TextWrapping="Wrap"
                                       Text="Internet Archive default uses the Internet Archive's own ordering, which is not ranked by relevance. Most downloaded lists the most-downloaded items first. Items with equal download counts are then ordered by identifier, so they appear in a consistent order. This is not a frozen snapshot: results can still shift between pages if items are added, removed, or change download count while you page."/>
                        </ToolTip>
                    </ComboBox.ToolTip>
                    <ComboBoxItem Content="Internet Archive default"/>
                    <ComboBoxItem Content="Most downloaded"/>
                </ComboBox>
                <Expander Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
                          x:Name="GenreExpander"
                          IsExpanded="False"
                          Margin="0,6,0,0"
                          AutomationProperties.Name="Genre">
                    <Expander.Header>
                        <TextBlock x:Name="GenreHeaderText"
                                   Text="Genre"
                                   FontSize="12"
                                   Foreground="{x:Static SystemColors.ControlTextBrush}"
                                   AutomationProperties.Name="Genre filter"/>
                    </Expander.Header>
                    <StackPanel Margin="0,6,0,6">
                            <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <CheckBox x:Name="GenreCheckboxAction" Grid.Row="0" Grid.Column="0"
                                      Content="Action" Click="OnGenreSelectionChanged"
                                      AutomationProperties.Name="Action genre"/>
                            <CheckBox x:Name="GenreCheckboxAdventure" Grid.Row="0" Grid.Column="1"
                                      Content="Adventure" Click="OnGenreSelectionChanged"
                                      AutomationProperties.Name="Adventure genre"/>
                            <CheckBox x:Name="GenreCheckboxAnimation" Grid.Row="0" Grid.Column="2"
                                      Content="Animation" Click="OnGenreSelectionChanged"
                                      AutomationProperties.Name="Animation genre"/>
                            <CheckBox x:Name="GenreCheckboxComedy" Grid.Row="0" Grid.Column="3"
                                      Content="Comedy" Click="OnGenreSelectionChanged"
                                      AutomationProperties.Name="Comedy genre"/>
                            <CheckBox x:Name="GenreCheckboxCrime" Grid.Row="1" Grid.Column="0"
                                      Content="Crime" Click="OnGenreSelectionChanged"
                                      AutomationProperties.Name="Crime genre"/>
                            <CheckBox x:Name="GenreCheckboxDocumentary" Grid.Row="1" Grid.Column="1"
                                      Content="Documentary" Click="OnGenreSelectionChanged"
                                      AutomationProperties.Name="Documentary genre"/>
                            <CheckBox x:Name="GenreCheckboxDrama" Grid.Row="1" Grid.Column="2"
                                      Content="Drama" Click="OnGenreSelectionChanged"
                                      AutomationProperties.Name="Drama genre"/>
                            <CheckBox x:Name="GenreCheckboxFamily" Grid.Row="1" Grid.Column="3"
                                      Content="Family" Click="OnGenreSelectionChanged"
                                      AutomationProperties.Name="Family genre"/>
                            <CheckBox x:Name="GenreCheckboxFantasy" Grid.Row="2" Grid.Column="0"
                                      Content="Fantasy" Click="OnGenreSelectionChanged"
                                      AutomationProperties.Name="Fantasy genre"/>
                            <CheckBox x:Name="GenreCheckboxHorror" Grid.Row="2" Grid.Column="1"
                                      Content="Horror" Click="OnGenreSelectionChanged"
                                      AutomationProperties.Name="Horror genre"/>
                            <CheckBox x:Name="GenreCheckboxMystery" Grid.Row="2" Grid.Column="2"
                                      Content="Mystery" Click="OnGenreSelectionChanged"
                                      AutomationProperties.Name="Mystery genre"/>
                            <CheckBox x:Name="GenreCheckboxRomance" Grid.Row="2" Grid.Column="3"
                                      Content="Romance" Click="OnGenreSelectionChanged"
                                      AutomationProperties.Name="Romance genre"/>
                            <CheckBox x:Name="GenreCheckboxScienceFiction" Grid.Row="3" Grid.Column="0"
                                      Content="Science fiction" Click="OnGenreSelectionChanged"
                                      AutomationProperties.Name="Science fiction genre"/>
                            <CheckBox x:Name="GenreCheckboxThriller" Grid.Row="3" Grid.Column="1"
                                      Content="Thriller" Click="OnGenreSelectionChanged"
                                      AutomationProperties.Name="Thriller genre"/>
                            <CheckBox x:Name="GenreCheckboxWar" Grid.Row="3" Grid.Column="2"
                                      Content="War" Click="OnGenreSelectionChanged"
                                      AutomationProperties.Name="War genre"/>
                            <CheckBox x:Name="GenreCheckboxWestern" Grid.Row="3" Grid.Column="3"
                                      Content="Western" Click="OnGenreSelectionChanged"
                                      AutomationProperties.Name="Western genre"/>
                        </Grid>
                        <Button x:Name="ClearGenresButton"
                                Content="Clear genres"
                                Width="120" Height="30"
                                IsEnabled="False"
                                HorizontalAlignment="Left"
                                Click="OnClearGenresClick"
                                AutomationProperties.Name="Clear genres"/>
                    </StackPanel>
                </Expander>
                <CheckBox x:Name="ExcludeTrailersCheckBox"
                          Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2"
                          Content="Exclude trailers"
                          Margin="0,10,0,2"
                          VerticalAlignment="Center"
                          AutomationProperties.Name="Exclude trailers"
                          AutomationProperties.HelpText="Removes trailer entries by Internet Archive collection and subject metadata, and any item whose title contains the word trailer. This is aggressive: it can also hide full movies, mixed uploads that include trailers, and titles that merely contain the word, such as Trailer Park Boys. It does not remove every teaser, TV spot, or game promo; those disappear only when they match these rules.">
                    <CheckBox.ToolTip>
                        <ToolTip MaxWidth="380">
                            <TextBlock MaxWidth="380"
                                       TextWrapping="Wrap"
                                       Text="Removes trailer entries by Internet Archive collection and subject metadata, and any item whose title contains the word trailer. This is aggressive: it can also hide full movies, mixed uploads that include trailers, and titles that merely contain the word, such as Trailer Park Boys. It does not remove every teaser, TV spot, or game promo; those disappear only when they match these rules."/>
                        </ToolTip>
                    </CheckBox.ToolTip>
                </CheckBox>
                <StackPanel Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2"
                            Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="ClearAllFiltersButton"
                            Content="Clear all filters"
                            Width="140" Height="30"
                            HorizontalAlignment="Left"
                            Click="OnClearAllFiltersClick"
                            AutomationProperties.Name="Clear all filters"
                            AutomationProperties.HelpText="Resets every filter in Narrow results to its default. Your main search text and Search scope choice are kept. Does not start a search."/>
                    <TextBlock x:Name="DiscoveryStateText"
                               Margin="10,0,0,0"
                               FontSize="11"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{x:Static SystemColors.ControlTextBrush}"
                               AutomationProperties.Name="Active filters"/>
                </StackPanel>
                <TextBlock x:Name="FilterMessageText"
                           Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"
                           Visibility="Collapsed"
                           Foreground="{x:Static SystemColors.ControlTextBrush}"
                           AutomationProperties.Name="Filter message"
                           AutomationProperties.LiveSetting="Assertive"/>
            </Grid>
        </Expander>

        <TextBlock x:Name="ScrollHintText"
                   Text="More options and status are below — scroll down."
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,2,0,6"
                   Visibility="Collapsed"
                   Foreground="{x:Static SystemColors.ControlTextBrush}"/>

        <TextBlock Text="Search public Internet Archive movie and video titles."
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,12,0,8"
                   Foreground="{x:Static SystemColors.ControlTextBrush}"/>

        <ProgressBar x:Name="SearchProgress"
                     Height="6"
                     IsIndeterminate="True"
                     Visibility="Collapsed"
                     AutomationProperties.Name="Search progress"/>
        <TextBlock x:Name="StatusText"
                   Text="Enter a search term."
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0"
                   Foreground="{x:Static SystemColors.ControlTextBrush}"
                   AutomationProperties.Name="Search status"/>

        <Border x:Name="ResultStage"
                BorderThickness="1"
                BorderBrush="{x:Static SystemColors.ActiveBorderBrush}"
                Background="{x:Static SystemColors.ControlBrush}"
                Padding="8"
                Margin="0,10,0,0"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="ResultStageText"
                           Text=""
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,0,0,6"
                           Foreground="{x:Static SystemColors.ControlTextBrush}"/>
                <Button x:Name="OpenResultsButton"
                        Content="No Results"
                        Width="150" Height="32"
                        HorizontalAlignment="Left"
                        IsEnabled="False"
                        Click="OnOpenResultsClick"/>
            </StackPanel>
        </Border>
<Border BorderThickness="1"
                BorderBrush="{x:Static SystemColors.ActiveBorderBrush}"
                Background="{x:Static SystemColors.ControlBrush}"
                Padding="8"
                Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="External player"
                           FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"
                           Foreground="{x:Static SystemColors.ControlTextBrush}"/>
                <TextBox x:Name="PlayerPathText"
                         IsReadOnly="True"
                         FontSize="11"
                         TextWrapping="Wrap"
                         Margin="0,0,0,6"
                         BorderBrush="{x:Static SystemColors.ActiveBorderBrush}"
                         AutomationProperties.Name="External player executable path"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button x:Name="ChoosePlayerButton"
                            Content="Choose player…"
                            Width="130" Height="30"
                            Margin="0,0,8,0"
                            Click="OnChoosePlayerClick"/>
                    <Button x:Name="ChangePlayerButton"
                            Content="Change…"
                            Width="96" Height="30"
                            Margin="0,0,8,0"
                            Visibility="Collapsed"
                            Click="OnChoosePlayerClick"/>
                    <Button x:Name="ClearPlayerButton"
                            Content="Clear"
                            Width="80" Height="30"
                            Visibility="Collapsed"
                            Click="OnClearPlayerClick"/>
                </StackPanel>
                <TextBlock x:Name="PlayerStatusText"
                           Text="Select a media-player executable (.exe) to open selected video streams."
                           FontSize="12" TextWrapping="Wrap"
                           Foreground="{x:Static SystemColors.ControlTextBrush}"
                           AutomationProperties.Name="External player status"/>
            </StackPanel>
        </Border>
    </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
